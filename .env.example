# ═══════════════════════════════════════════════
# StudioSage Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env and fill in real values.
# Generate strong secrets with: openssl rand -hex 32

# ── REQUIRED ── (app will fail startup without these)
JWT_SECRET=generate-with-openssl-rand-hex-32
CLIENT_JWT_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ── AI (at least one required for AI features) ──
ANTHROPIC_API_KEY=sk-ant-api03-...
# DEEPSEEK_API_KEY=sk-...
# Optional: override default models
# CLAUDE_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_MODEL=deepseek-chat

# ── Stripe (for payments) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...        # $9/mo Starter plan
STRIPE_PRICE_PRO=price_...            # $19/mo Pro plan
STRIPE_PRICE_PRO_ANNUAL=price_...     # $15/mo billed annually ($180/yr)

# ── App ──
APP_URL=https://studiosa.ge
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://studiosa.ge

# ── Logging (optional) ──
# LOG_LEVEL=debug|info|warn|error (default: info in production)
# LOG_FORMAT=plain|json (default: plain, set to json for log aggregators)

# ── Error Monitoring (optional) ──
# SENTRY_DSN=https://key@o123.ingest.sentry.io/project123

# ── File Storage (optional — falls back to local /uploads) ──
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=...
# R2_SECRET_KEY=...
# R2_BUCKET=studiosage
# R2_PUBLIC_URL=https://cdn.studiosa.ge

# ── Optional integrations ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PIXIESET_API_KEY=
