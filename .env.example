# ── Required ──
JWT_SECRET=change-me-to-a-random-string-32-chars
CLIENT_JWT_SECRET=change-me-to-another-random-string

# AI (至少配一个)
ANTHROPIC_API_KEY=sk-ant-api03-...
# DEEPSEEK_API_KEY=sk-...

# Stripe (收钱)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...           # $19/mo
STRIPE_PRICE_PRO_ANNUAL=price_...    # $15/mo billed annually ($180/yr)

# App
APP_URL=https://studiosa.ge
PORT=3001
NODE_ENV=production

# ── File Storage (optional — falls back to local /uploads) ──
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=studiosage
R2_PUBLIC_URL=https://cdn.studiosa.ge

# ── Optional integrations ──
ENCRYPTION_KEY=
PIXIESET_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
